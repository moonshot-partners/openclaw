# TPC-specific OpenClaw image
#
# Extends the base OpenClaw image with agent-browser + Chromium for
# the Buyer Acquisition agent's web research capability.
#
# Build locally (after building base image):
#   docker build -t openclaw:local .
#   docker build -f Dockerfile.tpc -t openclaw-tpc:local .
#
# Build via CI:
#   Pushed automatically to ghcr.io/moonshot-partners/openclaw-tpc
#   on tag push (see .github/workflows/build-tpc.yml)

ARG BASE_IMAGE=openclaw:local
FROM ${BASE_IMAGE}

# Switch to root for global installs and system deps
USER root

# Install agent-browser and playwright globally
RUN npm install -g agent-browser@latest playwright

# Install Chromium with system dependencies
# --with-deps installs required system libraries (libglib, libnss, etc.)
RUN npx playwright install --with-deps chromium

# Make global node_modules accessible to node user
RUN chmod -R a+r /usr/local/lib/node_modules

# Switch back to node user (matches base image)
USER node

# Set NODE_PATH so node user can find globally installed modules
ENV NODE_PATH=/usr/local/lib/node_modules

# Verify installations
RUN agent-browser --version && \
    node -e "require('playwright'); console.log('playwright: ok')"
